# MTK connectivity .rc configure

on boot

# WMT
service wmt_loader /vendor/bin/wmt_loader
    class core
    user root
    # /dev/wmtdetect is system:system 0660.  Membership avoids granting the
    # loader the forbidden global DAC-override capability.
    group root system
    oneshot

service wmt_launcher /vendor/bin/wmt_launcher -p /vendor/firmware/
    user system
    group system
    class core
    disabled

# Do not let the launcher poll service.wcn.driver.ready forever when the
# one-shot loader cannot initialize the combo chip.
on property:service.wcn.driver.ready=yes
    start wmt_launcher

on property:service.wcn.coredump.mode=2
start stp_dump

service stp_dump /vendor/bin/stp_dump3
    user root
    group root
    class core
    disabled
    oneshot
