#
# iddd.rc
#
on fs
    # SONY: setup idd and rca partition
    chown vendor_idd vendor_idd /idd
    chmod 0751 /idd
    symlink /idd /mnt/idd
    chown vendor_idd vendor_idd /rca
    chmod 0750 /rca
    symlink /rca /mnt/rca

on post-fs-data
    mkdir idd/lost+found 0770 root root
    mkdir idd/output 0755 vendor_idd vendor_idd
    mkdir idd/socket 0711 vendor_idd vendor_idd
    mkdir idd/private 0700 vendor_idd vendor_idd
    mkdir idd/input 0755 vendor_idd vendor_idd
    exec u:r:restorecon:s0 -- /vendor/bin/restorecon -RF /idd
    mkdir rca/plugins 0750 vendor_idd vendor_idd
    exec u:r:restorecon:s0 -- /vendor/bin/restorecon -RF /rca

# Start idd native service
service iddd /vendor/bin/iddd
    class core
    disabled
    user vendor_idd
    group vendor_idd log inet vendor_trimarea
